--- a/crond	2024-12-02 17:36:53.122212965 +0200
+++ b/crond	2024-12-02 17:37:43.699430049 +0200
@@ -6,10 +6,12 @@
 SSD=/sbin/start-stop-daemon
 PROG=/usr/sbin/crond
 PIDFILE=/run/crond.pid
-OPTS="-S -l info -p ${PIDFILE}"
+OPTS="-S -l notice -p ${PIDFILE}"
 
 case $1 in
 start)
+    mkdir -p /run/cron
+    chmod 1777 /run/cron
     $SSD --start --exec $PROG -- $OPTS
     ;;
 stop)
