# Description: An RFC2131-compliant DHCP client daemon
# URL: https://roy.marples.name/projects/dhcpcd/
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: eudev

name=dhcpcd
version=10.3.2
release=1
source=(https://github.com/NetworkConfiguration/dhcpcd/releases/download/v$version/$name-$version.tar.xz
    rc.dhcpcd
    dhcpcd.conf-Don-t-invoke-wpa_supplicant-by-default.patch
    dhcpcd.conf-request_ntp_server_by_default.patch
    use-hostname_short-in-dhcpcd.conf.patch)

build() {
    cd $name-$version

    patch -p1 -i $SRC/dhcpcd.conf-Don-t-invoke-wpa_supplicant-by-default.patch
    patch -p1 -i $SRC/dhcpcd.conf-request_ntp_server_by_default.patch
    patch -p1 -i $SRC/use-hostname_short-in-dhcpcd.conf.patch

    ./configure \
        --prefix= \
        --libexecdir=/lib/dhcpcd \
        --dbdir=/var/lib/dhcpcd \
        --sysconfdir=/etc/dhcpcd \
        --rundir=/run/dhcpcd \
        --enable-privsep \
        --privsepuser=dhcpcd

    make
    make DESTDIR=$PKG install

    install -d -o dhcpcd -g dhcpcd $PKG/var/lib/dhcpcd
    install -D -m 0755 $SRC/rc.dhcpcd $PKG/etc/rc.d/dhcpcd

    chmod -R u+w $PKG
}
