# Description: A set of utilities to manage software packages
# URL: https://git.crux.nu/tools/pkgutils
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: libarchive

name=pkgutils
version=5.40.12
release=2
source=(https://crux.nu/files/$name-$version.tar.xz
    pkgadd.conf.patch
    pkgmk.conf.patch
    pkgmk-add-support-with-footprint-riscv64-aarch64.patch)

build () {
    cd $name-$version
    patch -p1 -i $SRC/pkgadd.conf.patch
    patch -p1 -i $SRC/pkgmk.conf.patch
    patch -p1 -i $SRC/pkgmk-add-support-with-footprint-riscv64-aarch64.patch
    make DESTDIR=$PKG install
}
