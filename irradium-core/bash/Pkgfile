# Description: An sh-compatible command language interpreter
# URL: https://tiswww.case.edu/php/chet/bash/bashtop.html
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: readline

name=bash
version=5.3.15
release=2
source=(https://ftpmirror.gnu.org/gnu/$name/$name-${version:0:3}.tar.gz
    profile
    profile.patch
    locale.sh
    home-profile.d.sh
    $name-$version.patch.gz)

build() {
    patch -p1 -i $SRC/profile.patch

    cd $name-${version:0:3}

    gunzip -c $SRC/$name-$version.patch.gz | patch -p0

    ./configure \
        --prefix=/usr \
        --exec-prefix= \
        --disable-nls \
        --with-curses \
        --with-installed-readline
    make -j1

    install -D -m 755 bash $PKG/bin/bash
    install -D -m 644 doc/bash.1 $PKG/usr/share/man/man1/bash.1
    install -D -m 644 $SRC/profile $PKG/etc/profile
    install -D -m 755 $SRC/locale.sh $PKG/etc/profile.d/locale.sh
    install -D -m 755 $SRC/home-profile.d.sh $PKG/etc/profile.d/home-profile.d.sh
}
