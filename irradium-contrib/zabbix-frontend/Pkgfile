# Description: zabbix web-interface
# URL: https://www.zabbix.com
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: zabbix-server apache php php-fpm php-gd php-pgsql php-ldap php-mbstring php-gettext php-sockets

name=zabbix-frontend
version=7.4.5
release=1
source=(https://cdn.zabbix.com/zabbix/sources/stable/${version%.*}/zabbix-$version.tar.gz
        apache-zabbix.conf
        php-fpm-zabbix.conf)

build() {
  cd ${name%-*}-$version

  install -D -m644 $SRC/apache-zabbix.conf \
    $PKG/etc/apache/extra/zabbix.conf

  install -D -m644 $SRC/php-fpm-zabbix.conf \
    $PKG/etc/php/php-fpm.d/zabbix.conf

  mkdir -p "$PKG"/usr/share/zabbix/
  cp -a ui "$PKG"/usr/share/zabbix/
}
