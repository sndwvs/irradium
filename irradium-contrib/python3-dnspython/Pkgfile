# Description: dns toolkit for python3
# URL: https://www.dnspython.org/
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: python3 python3-cython python3-hatchling python3-wheel

name=python3-dnspython
version=2.8.0
release=1
source=(https://github.com/rthalley/dnspython/archive/v$version/dnspython-$version.tar.gz)

build() {
  cd dnspython-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
