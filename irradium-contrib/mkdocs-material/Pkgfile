# Description: documentation that simply works
# URL: https://github.com/squidfunk/mkdocs-material
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: mkdocs python3-gpep517 python3-hatch-nodejs-version python3-hatch-requirements-txt python3-hatchling

name=mkdocs-material
version=9.6.14
release=1
source=(https://github.com/squidfunk/mkdocs-material/archive/refs/tags/$version.tar.gz)

build() {
    cd $name-$version

    python3 -m build --wheel --no-isolation
    python3 -m installer --destdir=$PKG dist/*.whl
}
