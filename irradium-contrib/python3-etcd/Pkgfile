# Description: a python client for etcd
# URL: https://github.com/jplana/python-etcd
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: python3 python3-urllib3 python3-dnspython

name=python3-etcd
version=0.4.5
release=1
source=(https://github.com/jplana/python-etcd/archive/refs/tags/$version.tar.gz)

build() {
  cd python-etcd-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
