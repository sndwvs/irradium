# Description: proprietary bifrost g52 mali driver X11 gbm
# URL: https://github.com/JeffyCN/mirrors/commits/libmali
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: cmake ninja

name=libmali-bifrost-g52-x11-gbm
version=g13p0
release=2
_commit=da4d6040166cc3d4f0b5c9bfff82e0ef6b6e3a17
source=(https://github.com/JeffyCN/mirrors/archive/${_commit}.tar.gz
        00-libmali.conf)

build() {
  cd mirrors-${_commit}

  mkdir meson-build
  cd meson-build
  meson setup \
    --prefix=/usr \
    --libdir=lib/libmali \
    --sysconfdir=/etc \
    -Dgpu="bifrost-g52" \
    -Dplatform="x11-gbm" \
    -Dversion=$version \
    -Dhooks=false \
    -Dwrappers=disabled \
    .. || exit 1

  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
  cd ..

  install -Dm644 $SRC/00-libmali.conf $PKG/etc/ld.so.conf.d/00-libmali.conf
  mv $PKG/usr/lib/libmali/pkgconfig $PKG/usr/lib/

  install -d $PKG/etc/revdep.d
  echo "/usr/lib/libmali" > $PKG/etc/revdep.d/$name
}
