# Description: a playlist-oriented media player with multiple interfaces (plugins)
# URL: https://audacious-media-player.org/
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: alsa-lib audacious autoconf automake curl faad2 ffmpeg flac lame libcddb libcdio libcdio-paranoia libcue libnotify libogg libsamplerate libsndfile libvorbis xorg-libxcomposite libxml2 meson mpg123 neon wavpack
# Optional: pulseaudio sdl2

name=audacious-plugins
version=4.4.2
release=1
source=(http://distfiles.audacious-media-player.org/$name-$version.tar.bz2)

build() {
  cd $name-$version

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --libexecdir=/usr/lib/$name \
    --bindir=/usr/bin \
    --sbindir=/usr/sbin \
    --includedir=/usr/include \
    --datadir=/usr/share \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Db_lto=true \
    -Dgtk=true \
    -Dqt=false \
    -Dmms=false

  meson compile -C build
  DESTDIR=$PKG meson install --no-rebuild -C build
}
