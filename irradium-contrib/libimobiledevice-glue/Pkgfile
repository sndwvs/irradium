# Description: Library for common code of the libimobiledevice project
# URL: https://libimobiledevice.org
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: libplist

name=libimobiledevice
version=1.3.1
release=1
source=(https://github.com/libimobiledevice/libimobiledevice/releases/download/$version/libimobiledevice-glue-$version.tar.bz2)

build() {
  cd $name-$version

  export CFLAGS="$CFLAGS -flto=auto"
  ./configure \
    --prefix=/usr \
    --disable-static

  make
  make DESTDIR=$PKG install
}
