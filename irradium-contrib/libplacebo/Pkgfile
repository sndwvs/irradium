# Description: Reusable library for GPU-accelerated video/image rendering primitives
# URL: https://github.com/haasn/libplacebo
# Maintainer: John McQuah, jmcquah at disroot dot org
# Depends on: glad lcms2 shaderc vulkan-loader
# Optional: libunwind

name=libplacebo
version=7.349.0
release=2
source=(https://github.com/haasn/$name/archive/v$version/$name-$version.tar.gz
        glslang-deps.patch)

build() {
    patch -p1 -d $name-$version -i $SRC/glslang-deps.patch
    meson setup build $name-$version \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode nodownload \
        -D b_lto=true \
        -D b_pie=true \
        -D vulkan=enabled \
        -D vulkan-registry=/usr/share/vulkan/registry/vk.xml \
        -D shaderc=enabled \
        -D glslang=enabled \
        -D lcms=enabled \
        -D d3d11=disabled \
        -D demos=false \
        -D tests=false

    meson compile -C build -j ${JOBS:-1}
    DESTDIR=$PKG meson install -C build
}
