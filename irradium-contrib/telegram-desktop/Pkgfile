# Description: Official Telegram Desktop client
# URL: https://desktop.telegram.org
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: minizip openal range-v3 tg_owt qt6-imageformats qt6-svg qt6-wayland qt6-5compat rnnoise protobuf fmt graphviz mm-common boost libsigc++ ada

name=telegram-desktop
version=7.1.3
release=1
_commitid=8921c22f0f85b3cb0b56303f9cba81ba8549f4e8
source=(https://github.com/telegramdesktop/tdesktop/releases/download/v$version/tdesktop-$version-full.tar.gz
        https://github.com/tdlib/td/archive/$_commitid.tar.gz)

build() {
  cd tdesktop-$version-full

  LDFLAGS="$LDFLAGS -Wl,-z,stack-size=1024768"
  cmake -S $SRC/td-$_commitid -B $SRC/td-$_commitid/build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX="$SRC/td-$_commitid/install" \
    -Wno-dev \
    -DTD_E2E_ONLY=ON
  cmake --build $SRC/td-$_commitid/build
  cmake --install $SRC/td-$_commitid/build

  export CXXFLAGS+=" -fpermissive"

  cmake -B build -G Ninja . \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Dtde2e_DIR="$SRC/td-$_commitid/install/lib/cmake/tde2e" \
    -DCMAKE_BUILD_TYPE=MinSizeRel \
    -DTDESKTOP_API_ID=28851236 \
    -DTDESKTOP_API_HASH=830f83e5afbad782af2704a120e4dcdf \
    -DDESKTOP_APP_DISABLE_CRASH_REPORTS=ON \
    -DDESKTOP_APP_USE_PACKAGED=ON

  cmake --build build
  DESTDIR=$PKG cmake --install build
}
