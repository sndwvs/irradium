+  constexpr auto Nmax = simdutf::maximal_binary_length_from_base64(input);
+  CTString<char, Nmax> buffer{};
+  auto res = simdutf::base64_to_binary(input, buffer);
+  if (res.is_err()) {
+    throw "failed convert";
