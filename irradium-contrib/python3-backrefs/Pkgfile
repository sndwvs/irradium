# Description: wrapper around re or regex that adds additional back references
# URL: https://github.com/facelessuser/backrefs
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: python3-build python3-hatchling python3-installer python3-wheel python3-pytest python3-regex

name=python3-backrefs
version=5.8
release=1
source=(https://github.com/facelessuser/backrefs/archive/refs/tags/$version.tar.gz)

build() {
  cd backrefs-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
