# Description: xmodem, ymodem and zmodem file transfer protocols
# URL: https://www.ohse.de/uwe/software/lrzsz.html
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: gcc

name=lrzsz
version=0.12.20
release=1
source=(https://www.ohse.de/uwe/releases/$name-$version.tar.gz
        lrzsz-0.12.20.patch
        lrzsz.patch
        program-name.patch)

build() {
    cd $name-$version

    patch -Np1 -i $SRC/lrzsz.patch
    patch -Np1 -i $SRC/lrzsz-0.12.20.patch
    patch -Np1 -i $SRC/program-name.patch # Make it work with modified binary names

    sed -i 's|${CC-cc} -E|${CC-cc} -O2 -E|g' configure
    export CFLAGS="$CFLAGS -std=gnu89"

    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --program-transform-name=s/l/lrzsz-/

    make -j1
    make -j1 DESTDIR=$PKG install
}
