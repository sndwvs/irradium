# Description: scripts for network interface bonding
# URL: https://www.kernel.org/doc/html/latest/networking/bonding.html
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: dhcpcd

name=bonding
version=6.17
release=1
source=(rc.bonding bonding.conf)

build() {
    install -D -m 0644 $SRC/bonding.conf $PKG/etc/modprobe.d/bonding.conf
    install -D -m 0755 $SRC/rc.bonding $PKG/etc/rc.d/bonding
}
