# Description: python client for consul
# URL: https://github.com/criteo/py-consul
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: python3-build python3-installer python3-setuptools

name=python3-py-consul
version=1.7.1
release=1
source=(https://github.com/criteo/py-consul/archive/refs/tags/v${version}.tar.gz)

build() {
  cd py-consul-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
