#!/bin/sh
#
# /etc/rc.d/keepalived: start/stop keepalived
#

SSD=/sbin/start-stop-daemon
PROG=/usr/bin/keepalived
CONF=/etc/keepalived/keepalived.conf
PID=/run/keepalived/keepalived.pid
LOG=/var/log/keepalived.log
OPTS="--no-syslog --log-detail --log-console --dont-fork --use-file=$CONF"

case $1 in
    start)
        $SSD --start -b --exec $PROG -O $LOG -- $OPTS
        ;;
    stop)
        $SSD --stop --retry 10 --pidfile $PID
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    status)
        $SSD --status --pidfile $PID
        case $? in
        0) echo "$PROG is running with pid $(cat $PID)" ;;
        1) echo "$PROG is not running but the pid file $PID exists" ;;
        3) echo "$PROG is not running" ;;
        4) echo "Unable to determine the program status" ;;
        esac
        ;;
    *)
        echo "Usage: $0 [start|stop|restart|status]"
        ;;
esac

# End of file
