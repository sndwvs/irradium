# Description: tool for tuning TimescaleDB for better performance
# URL: https://github.com/timescale/timescaledb-tune
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: glibc postgresql go git

name=timescaledb-tune
version=0.18.1
release=1
source=(https://github.com/timescale/timescaledb-tune/archive/refs/tags/v$version.tar.gz)

build() {
  cd $name-$version

  export GOCACHE="${GOCACHE:-"$SRC/go-cache"}"
  export GOTMPDIR="${GOTMPDIR:-"$SRC"}"
  export GOMODCACHE="${GOMODCACHE:-"$SRC/go"}"
  export GOPATH="$SRC/zabbix-$version"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"

  mkdir build

  go build -v \
    -buildmode=pie \
    -trimpath \
    -mod=readonly \
    -modcacherw \
    -ldflags "-linkmode external -extldflags '${LDFLAGS}'" \
    -o build \
    ./cmd/...

  install -Dm755 "build/$name" -t "$PKG/usr/bin"
}
