# Description: Library interface to record user sessions in utmp/wtmp files
# URL: http://freecode.com/projects/libutempter
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: gcc

name=libutempter
version=1.2.3
release=1
source=(https://github.com/altlinux/libutempter/archive/$version-alt1.tar.gz)

build() {
  cd $name-$version-alt1/$name

  make CFLAGS="$CFLAGS -I/usr/include/utmps"
  make DESTDIR=$PKG install
  chown root:utmp $PKG/usr/lib/utempter/utempter
  chmod 2755 $PKG/usr/lib/utempter/utempter

}
