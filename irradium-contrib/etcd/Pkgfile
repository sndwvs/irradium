# Description: a highly-available key value store for shared configuration and service discovery
# URL: https://github.com/etcd-io/etcd
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: git go bash

name=etcd
version=3.6.9
release=1
source=(https://github.com/etcd-io/etcd/archive/v$version.tar.gz
        rc.etcd
        etcd.yaml)

build() {
  export GOCACHE="${GOCACHE:-"$SRC/go-cache"}"
  export GOTMPDIR="${GOTMPDIR:-"$SRC"}"
  export GOMODCACHE="${GOMODCACHE:-"$SRC/go"}"
  export GOFLAGS="$GOFLAGS -mod=mod"
  export CGO_ENABLED=1

  cd $name-$version

  GIT_SHA="$(git ls-remote https://github.com/coreos/etcd.git refs/tags/v$version | awk '{print $1}')"
  sed "s:GitNotFound:$GIT_SHA:g" -i scripts/build_lib.sh
  make

  install -D -d -m750 -o etcd -g etcd $PKG/var/lib/etcd
  install -D -d -m750 -o root -g etcd $PKG/etc/etcd
  install -Dm644 $SRC/etcd.yaml $PKG/etc/etcd/conf.yml
  install -Dm755 bin/etcd $PKG/usr/bin/etcd
  install -Dm755 bin/etcdctl $PKG/usr/bin/etcdctl
  install -Dm755 $SRC/rc.etcd $PKG/etc/rc.d/etcd
}
