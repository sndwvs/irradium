+  std::unique_ptr<BlockNode> create_block(
+      std::vector<std::unique_ptr<ParseNode>> statements = {});
+
+  // Synthesizes a new target: `<type>("<name>") { ... }`
+  std::unique_ptr<FunctionCallNode> create_target(
+      std::string_view type,
