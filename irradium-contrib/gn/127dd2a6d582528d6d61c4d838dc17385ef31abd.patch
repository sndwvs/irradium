+  _ASSIGN_OR_RETURN_IMPL(_STATUS_CONCAT(_expected_value, __COUNTER__), lhs, \
+                         rexpr)
+
+#define _ASSIGN_OR_RETURN_IMPL(expected_val, lhs, rexpr) \
+  auto expected_val = (rexpr);                           \
+  if (!expected_val) {                                   \
