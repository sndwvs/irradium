+TEST(Label, GetUserVisibleName) {
+  const struct TestCase {
+    const SourceDir dir;
+    const char* name;
+    const SourceDir toolchain_dir;
+    const char* toolchain_name;
+    bool include_toolchain;
+    const char* expected;
+  } test_cases[] = {
