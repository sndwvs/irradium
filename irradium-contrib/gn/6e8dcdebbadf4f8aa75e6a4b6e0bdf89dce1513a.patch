+
+bool HeaderChecker::ReachabilityCache::SearchBreadcrumbs(
+    const Target* search_for,
+    bool permitted,
+    Chain* chain) const {
+  const BreadcrumbTable& breadcrumbs =
+      permitted ? permitted_breadcrumbs_ : any_breadcrumbs_;
