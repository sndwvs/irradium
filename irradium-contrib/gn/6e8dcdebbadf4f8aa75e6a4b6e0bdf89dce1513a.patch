+  scheduler().Run();
+
+  // Now both should be resolved.
+  EXPECT_TRUE(a_record->is_resolved());
+  BuilderRecord* b_record = builder_.GetRecord(b_label);
+  EXPECT_TRUE(b_record->is_resolved());
