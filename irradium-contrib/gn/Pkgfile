# Description: Meta-build system that generates build files for Ninja
# URL: https://gn.googlesource.com/gn
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: python3 zstd

name=gn
version=20260409
release=1
source=(https://ab-sn.lnl.gay/gn-0eb071f600702e6e235137ba133ee8834aeece83.tar.zst
        78e67afc82faf52b2f7025265d412fd7418d88c2.patch)


build() {
    cd $name

    patch -p1 -i $SRC/78e67afc82faf52b2f7025265d412fd7418d88c2.patch

    export CC=gcc
    export CXX=g++
    unset CFLAGS # all sources C++ but passes both
    # Breaks build since upstream passes -Wno-format,
    # annotated: "Use of %llx, which is supported by _UCRT, false positive"
    CXXFLAGS="${CXXFLAGS/-Werror=format-security} -flto=auto" \
    python3 ./build/gen.py \
        --no-last-commit-position \
        --no-static-libstdc++ \
        --no-strip \
        --allow-warnings

    ninja -C out

    install -Dm755 out/gn $PKG/usr/bin/gn
}
