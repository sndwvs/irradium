+      "\n"
+      "build phony/foo/root.linkdeps: phony obj/foo/root.root.o\n"
+      "build phony/foo/root: phony phony/foo/root.linkdeps\n";
+
+  EXPECT_EQ(expected_root_ninja, root_ninja_str);
 }
