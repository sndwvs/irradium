+
+  writer.WritePublicModuleMap(modulemap_out, out_dir);
+
+  const char expected_modulemap[] =
+      "module \"//foo:bar\" {\n"
+      "  textual header \"../../../foo/public_header.h\"\n"
+      "  export *\n"
+      "}\n";
