+  const char expected_public[] =
+      "module \"//foo:root\" {\n"
+      "  textual header \"../../../foo/public_header.h\"\n"
+      "  extern module \"//foo:public_dep\" \"public_dep.modulemap\"\n"
+      "  use \"//foo:public_dep\"\n"
+      "  export *\n"
+      "}\n";
