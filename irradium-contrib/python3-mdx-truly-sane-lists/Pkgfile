# Description: extension for python-markdown that makes lists truly sane
# URL: https://github.com/radude/mdx_truly_sane_lists
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: python3-setuptools python3-markdown

name=python3-mdx-truly-sane-lists
version=1.3
release=1
source=(https://github.com/radude/mdx_truly_sane_lists/archive/refs/tags/$version.tar.gz)

build() {
  cd mdx_truly_sane_lists-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
