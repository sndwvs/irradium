# Description: zabbix network monitoring agent
# URL: https://www.zabbix.com
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: libxml2 autoconf automake curl libevent libssh2 openssl pcre2

name=zabbix-agentd
version=7.4.9
release=1
source=(https://cdn.zabbix.com/zabbix/sources/stable/${version%.*}/zabbix-$version.tar.gz
        rc.zabbix-agentd
        zabbix_agentd.logrotate)

build() {
  cd ${name%-*}-$version

  # Fix config file locations
  sed -i conf/zabbix_agentd.conf \
      -e 's|SNMPTrapperFile=/tmp|SNMPTrapperFile=/var/log/zabbix|' \
      -e 's|PidFile=/tmp|PidFile=/run/zabbix|' \
      -e 's|LogFile=/tmp|LogFile=/var/log/zabbix|'

  export CFLAGS+=" -D_LARGEFILE64_SOURCE"

  # pass --export-dynamic to the linker
  # to make zabbix loadable modules work
  export LDFLAGS+=" -Wl,--export-dynamic"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc/zabbix \
    --mandir=/usr/share/man \
    --infodir=/usr/share/info \
    --disable-agent2 \
    --enable-agent \
    --disable-proxy \
    --disable-server \
    --enable-ipv6 \
    --with-net-snmp \
    --with-libcurl \
    --with-libxml2 \
    --with-openipmi \
    --with-unixodbc \
    --with-ssh2 \
    --with-openssl \
    --with-libpcre2

  make
  #make DESTDIR=$PKG install

  install -D -m755 src/zabbix_agent/zabbix_agentd \
    "$PKG"/usr/sbin/zabbix_agentd

  install -D -m644 man/zabbix_agentd.man \
    "$PKG"/usr/share/man/man8/zabbix_agentd.8

  install -d -m0750 -o zabbix -g zabbix \
    "$PKG"/run/zabbix "$PKG"/var/log/zabbix

  install -D -m0644 conf/zabbix_agentd.conf \
    "$PKG"/etc/zabbix/zabbix_agentd.conf

  install -d -m0644 "$PKG"/etc/zabbix/zabbix_agentd.d/

  install -D -m600 $SRC/zabbix_agentd.logrotate \
    $PKG/etc/logrotate.d/zabbix_agentd.conf

  install -D -m755 $SRC/rc.zabbix-agentd \
    $PKG/etc/rc.d/zabbix-agentd
}
