# Description: a template for postgresql ha with zookeeper, etcd or consul
# URL: https://github.com/patroni/patroni/
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: python3-requests python3-build python3-installer python3-setuptools python3-six python3-dateutil python3-ydiff python3-click python3-cryptography python3-psutil python3-prettytable python3-pyyaml python3-urllib3 python3-psycopg2 python3-wcwidth python3-py-consul python3-pysyncobj
# Optional: python3-dns python3-etcd python3-boto3 python3-kazoo

name=patroni
version=4.1.0
release=2
source=(https://github.com/patroni/patroni/archive/refs/tags/v${version}.tar.gz
        rc.patroni)

build() {
  cd $name-$version

  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install --root $PKG -O1 --skip-build

  mkdir -p $PKG/etc/patroni/callbacks
  touch $PKG/etc/patroni/callbacks/callbacks.sh

  # install sample yml files:
  cp postgres0.yml postgres1.yml $PKG/etc/patroni/

  install -m 755 -D $SRC/rc.patroni $PKG/etc/rc.d/patroni

  # we don't need to ship this file, per upstream:
  rm -f $PKG/usr/bin/patroni_wale_restore

  install -m 755 -d $PKG/var/log/patroni
}
