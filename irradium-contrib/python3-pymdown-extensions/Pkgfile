# Description: extensions for python markdown
# URL: https://github.com/facelessuser/pymdown-extensions
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: python3 python3-markdown python3-yaml python3-build python3-hatchling python3-installer python3-wheel python3-pytest python3-pygments

name=python3-pymdown-extensions
version=10.15
release=1
source=(https://github.com/facelessuser/pymdown-extensions/archive/refs/tags/$version.tar.gz)

build() {
  cd pymdown-extensions-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
