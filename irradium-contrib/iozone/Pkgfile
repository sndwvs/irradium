# Description: iozone filesystem benchmark
# URL: https://www.iozone.org
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: glibc

name=iozone
version=3.506
release=1
source=(https://www.iozone.org/src/current/iozone${version//./_}.tar)

build() {
  cd ${name}${version//./_}/src/current/

  rm -f ./*.o
  make linux CFLAGS="$CFLAGS -DHAVE_ANSIC_C -DHAVE_PREADV -DHAVE_PWRITEV"

  install -m755 -D iozone \
    $PKG/usr/bin/iozone

  install -Dm644 ../../docs/iozone.1 \
    $PKG/usr/share/man/man1/iozone.1
}
