# Description: Easy to use task manage
# URL: https://docs.xfce.org/apps/xfce4-taskmanager
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: libxfce4ui xfconf xorg-libxmu libwnck-gtk3

name=xfce4-taskmanager
version=1.6.0
release=1
source=(https://archive.xfce.org/src/apps/$name/${version%.*}/$name-$version.tar.xz)

build(){
  cd $name-$version

  meson build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var

  meson compile -C build
  meson install -C build --destdir $PKG
}
