# Description: A simple application to manage Xfce panel layouts
# URL: https://docs.xfce.org/apps/xfce4-panel-profiles/start
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: python3-gobject xfce4-panel intltool gtk3 python3-psutil

name=xfce4-panel-profiles
version=1.1.1
release=1
source=(https://archive.xfce.org/src/apps/$name/${version%.*}/$name-$version.tar.xz)

build(){
  cd $name-$version

  meson build \
    --prefix=/usr

  meson compile -C build
  meson install -C build --destdir $PKG

}
