# Description: System load plugin for the Xfce panel
# URL: https://docs.xfce.org/panel-plugins/xfce4-systemload-plugin
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: xfce4-panel intltool

name=xfce4-systemload-plugin
version=1.4.0
release=1
source=(https://archive.xfce.org/src/panel-plugins/$name/${version%.*}/$name-$version.tar.xz)

build(){
  cd $name-$version

  meson build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var

  meson compile -C build
  meson install -C build --destdir $PKG
}
