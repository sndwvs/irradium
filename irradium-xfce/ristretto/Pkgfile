# Description: image viewer for xfce
# URL: https://docs.xfce.org/apps/ristretto/start
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: cmake file libexif libxfce4ui meson thunar

name=ristretto
version=0.14.0
release=1
source=(https://archive.xfce.org/src/apps/$name/${version%.*}/$name-$version.tar.xz)

build(){
  cd $name-$version

  mkdir meson-build
  cd meson-build
  meson setup \
    --prefix=/usr \
    --libdir=lib \
    --libexecdir=/usr/lib/$name \
    --bindir=/usr/bin \
    --sbindir=/usr/sbin \
    --includedir=/usr/include \
    --datadir=/usr/share \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
  cd ..

}
