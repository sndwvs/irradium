# Description: Simple GTK+ 2 text editor for the Xfce desktop environment
# URL: https://www.xfce.org/
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: gspell gtk3 gtksourceview4 xfconf

name=mousepad
version=0.6.5
release=1
source=(https://archive.xfce.org/src/apps/$name/${version%.*}/$name-$version.tar.xz)

build(){
  cd $name-$version

  mkdir meson-build
  cd meson-build
  meson setup \
    --prefix=/usr \
    --libdir=lib \
    --libexecdir=/usr/lib/$name \
    --bindir=/usr/bin \
    --sbindir=/usr/sbin \
    --includedir=/usr/include \
    --datadir=/usr/share \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
  cd ..

}
