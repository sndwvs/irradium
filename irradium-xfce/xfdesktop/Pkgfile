# Description: Xfce's desktop manager
# URL: https://docs.xfce.org/xfce/xfdesktop/start
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: exo libwnck-gtk3 libxfce4ui libxfce4windowing libnotify startup-notification thunar

name=xfdesktop
version=4.20.0
release=2
source=(https://archive.xfce.org/src/xfce/$name/${version%.*}/$name-$version.tar.bz2)

build(){
  cd $name-$version

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-thunarx \
    --enable-notifications \
    --disable-debug \
    --enable-gtk-doc=no \
    --enable-x11 \
    --enable-wayland \
    --disable-nls

  make
  make DESTDIR=$PKG install || exit 1

}
