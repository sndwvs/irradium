# Description: Pulseaudio plugin for the Xfce4 panel
# URL: https://goodies.xfce.org/projects/panel-plugins/xfce4-pulseaudio-plugin
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: xfce4-panel libnotify libcanberra pulseaudio

name=xfce4-pulseaudio-plugin
version=0.5.1
release=1
source=(https://archive.xfce.org/src/panel-plugins/$name/${version%.*}/$name-$version.tar.xz)

build(){
  cd $name-$version

  mkdir meson-build
  cd meson-build
  meson setup \
    --prefix=/usr \
    --libdir=lib \
    --libexecdir=/usr/lib/$name \
    --bindir=/usr/bin \
    --sbindir=/usr/sbin \
    --includedir=/usr/include \
    --datadir=/usr/share \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
  cd ..

}
