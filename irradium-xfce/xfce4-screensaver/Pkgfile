# Description: Xfce Screensaver
# URL: https://docs.xfce.org/apps/screensaver/start
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: dbus-glib garcon libwnck-gtk3 libxklavier xorg-libxscrnsaver python3-gobject

name=xfce4-screensaver
version=4.20.1
release=1
source=(https://archive.xfce.org/src/apps/$name/${version%.*}/$name-$version.tar.xz
        clarify-desc-in-xfce-settings.patch)

build(){
  cd $name-$version

  # Clarify description in Xfce Settings menu
  patch -p1 --verbose -i $SRC/clarify-desc-in-xfce-settings.patch

  mkdir meson-build
  cd meson-build
  meson setup \
    --prefix=/usr \
    --libdir=lib \
    --libexecdir=/usr/lib/$name \
    --bindir=/usr/bin \
    --sbindir=/usr/sbin \
    --includedir=/usr/include \
    --datadir=/usr/share \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dsession-manager=elogind \
    -Dauthentication-scheme=pam \
    -Ddocs=disabled
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
  cd ..

}
