# Description: A clipboard plugin for the Xfce4 panel
# URL: https://docs.xfce.org/panel-plugins/xfce4-clipman-plugin
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: xfce4-panel intltool qrencode

name=xfce4-clipman-plugin
version=1.7.0
release=1
source=(https://archive.xfce.org/src/panel-plugins/$name/${version%.*}/$name-$version.tar.xz)

build(){
  cd $name-$version

  meson build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    -D x11=enabled \
    -D wayland=enabled

  meson compile -C build
  meson install -C build --destdir $PKG

}
