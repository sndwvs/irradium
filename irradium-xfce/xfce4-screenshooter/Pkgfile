# Description: An application to take screenshots
# URL: https://docs.xfce.org/apps/xfce4-screenshooter/start
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: xfce4-panel intltool libsoup3 hicolor-icon-theme

name=xfce4-screenshooter
version=1.11.2
release=1
source=(https://archive.xfce.org/src/apps/$name/${version%.*}/$name-$version.tar.xz)

build(){
  cd $name-$version

  meson build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    -D x11=enabled \
    -D wayland=enabled

  meson compile -C build
  meson install -C build --destdir $PKG
}
