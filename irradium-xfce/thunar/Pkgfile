# Description: Modern, fast and easy-to-use file manager for Xfce
# URL: https://docs.xfce.org/xfce/thunar/start
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: exo libxfce4ui gnome-icon-theme libgudev libnotify libexif

name=thunar
version=4.20.0
release=2
source=(https://archive.xfce.org/src/xfce/$name/${version%.*}/$name-$version.tar.bz2
        0001-Prevent-crash-when-loading-mount-point-emblem-1511.patch)

build(){
  cd $name-$version

  # Subject: [PATCH] Prevent crash when loading mount point emblem (#1511):
  patch -p1 --verbose -i $SRC/0001-Prevent-crash-when-loading-mount-point-emblem-1511.patch

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-gio-unix \
    --enable-gudev \
    --enable-notifications \
    --enable-exif \
    --disable-debug \
    --enable-gtk-doc=no \
    --disable-nls

  make
  make DESTDIR=$PKG install || exit 1

  rm -r $PKG/usr/share/{gtk-doc,doc}

}
