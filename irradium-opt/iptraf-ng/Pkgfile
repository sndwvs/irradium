# Description: an ip network monitoring tool
# URL: https://fedorahosted.org/iptraf-ng/
# Maintainer: mara, mara at fail dot pp dot ua
# Depends on: ncurses glibc

name=iptraf-ng
version=1.2.2
release=1
source=(https://github.com/$name/$name/archive/refs/tags/v$version.tar.gz)

build(){
  cd $name-$version

  make CFLAGS="$CFLAGS \
    -std=gnu99 -D_GNU_SOURCE" \
    prefix=/usr \
    sbindir_relative=bin

  make DESTDIR=$PKG prefix=/usr sbindir_relative=bin install
}
