# Description: XML library version 2
# URL: https://gitlab.gnome.org/GNOME/libxml2/-/wikis/home
# Maintainer: Juergen Daubert, jue at crux dot nu
# Depends on: zlib
# Optional: doxygen

name=libxml2
version=2.15.2
release=1
source=(https://github.com/GNOME/libxml2/archive/refs/tags/v${version}.tar.gz)

build() {
    prt-get isinst doxygen && PKGMK_LIBXML2+=' -D python=enabled'

    # Don't depend on git
    sed -i '19,22s/^/#/' $name-$version/meson.build

    meson setup $name-$version build $PKGMK_LIBXML2 \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode nodownload \
        -D b_lto=true \
        -D b_pie=true \
        -D legacy=enabled

    meson compile -C build -j ${JOBS:-1}
    DESTDIR=$PKG meson install -C build
}
