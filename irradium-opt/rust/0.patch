++    AVCHROMA_LOC_TOP         = 4,
++    AVCHROMA_LOC_BOTTOMLEFT  = 5,
++    AVCHROMA_LOC_BOTTOM      = 6,
++    AVCHROMA_LOC_NB               ///< Not part of ABI
++};
