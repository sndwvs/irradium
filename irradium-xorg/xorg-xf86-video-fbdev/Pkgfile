# Description: xorg driver xf86-video-fbdev
# URL: https://xorg.freedesktop.org/wiki
# Maintainer: CRUX Xorg Team, xorg-ports at crux dot nu
# Depends on: xorg-server

name=xorg-xf86-video-fbdev
version=0.5.1
release=2
source=(https://www.x.org/releases/individual/driver/xf86-video-fbdev-$version.tar.xz)

build() {
	cd xf86-video-fbdev-$version

	export CFLAGS="${CFLAGS/-fno-plt}"
	export CXXFLAGS="${CXXFLAGS/-fno-plt}"
	export LDFLAGS+=" -Wl,-z,lazy"
	# riscv64 fix error:
	# [    73.229] (EE) Failed to load /usr/lib/xorg/modules/drivers/fbdev_drv.so: /usr/lib/xorg/modules/drivers/fbdev_drv.so: undefined symbol: fbdevHWSave
	export LDFLAGS=${LDFLAGS/-Wl,-z,now/}

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
